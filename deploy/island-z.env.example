# Copy to /etc/island-z.env and replace the example domain/paths.
PORT=3001
CLIENT_ORIGINS=https://play.example.com
WORLD_CONFIG=/opt/island-z/server/world.config.json
WORLD_SAVE_DIR=/var/lib/island-z
NODE_ENV=production
# Enables server-authoritative movement and action checks. Set false only for a trusted community server.
ANTI_CHEAT_ENABLED=true
